{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.opensubtitles/guessit-js",
  "title": "guessit-js",
  "description": "Parse movie and TV filenames: title, year, season, episode, codecs, languages, release group.",
  "repository": {
    "url": "https://github.com/opensubtitles/guessit-js",
    "source": "github"
  },
  "websiteUrl": "https://opensubtitles.github.io/guessit-js/",
  "version": "5.3.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "guessit-js",
      "version": "5.3.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://guessit.opensubtitles.com/mcp"
    }
  ]
}
